        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    classDef system fill:#fff2cc,stroke:#dcb654,stroke-width:2px,color:#000;\n    classDef actor fill:#eaeff5,stroke:#8a99a8,stroke-width:1.5px,color:#000;\n\n    SYS((Hệ thống Quản lý&lt;br&gt;và Kết nối Tìm kiếm&lt;br&gt;Đồ thất lạc)):::system\n\n    SSO[Hệ thống Quản lý đào tạo -&lt;br&gt;nhân sự của trường]:::actor\n    CTSV[Phòng CTSV]:::actor\n    SV[Sinh viên&lt;br&gt;Mất / Nhặt đồ]:::actor\n    QLT[Sinh viên&lt;br&gt;quản lý trạm]:::actor\n    QTH[Quản trị hệ thống]:::actor\n    MAIL[Dịch vụ email&lt;br&gt;của trường]:::actor\n\n    %% Liên kết từ hệ thống Đào tạo\n    SSO --&gt;|thông tin sinh viên, email&lt;br&gt;để đăng nhập SSO| SYS\n\n    %% Liên kết Sinh viên\n    SV --&gt;|đăng tin, yêu cầu nhận, xác minh,&lt;br&gt;chat, đặt lịch hẹn| SYS\n    SYS --&gt;|kết quả tra cứu, AI gợi ý tin,&lt;br&gt;thông báo nhắc hẹn| SV\n\n    %% Liên kết Quản lý trạm\n    SYS --&gt;|danh sách đồ vật, lịch hẹn nhận,&lt;br&gt;danh sách đồ quá hạn| QLT\n    QLT --&gt;|quét mã định danh, trạng thái đồ,&lt;br&gt;biên bản bàn giao ca| SYS\n\n    %% Liên kết Quản trị\n    SYS --&gt;|danh sách tin chờ duyệt,&lt;br&gt;tài khoản vi phạm| QTH\n    QTH --&gt;|kiểm duyệt tin đăng, phân quyền,&lt;br&gt;cấu hình danh mục| SYS\n\n    %% Liên kết Phòng CTSV\n    SYS --&gt;|báo cáo thống kê hàng tháng,&lt;br&gt;biên bản thanh lý đồ| CTSV\n    CTSV --&gt;|yêu cầu xuất báo cáo| SYS\n\n    %% Liên kết Email\n    SYS --&gt;|email thông báo khớp tin,&lt;br&gt;nhắc lịch hẹn, cảnh báo| MAIL&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Ho58L_KTPXlBAyhXOjB8-2">
